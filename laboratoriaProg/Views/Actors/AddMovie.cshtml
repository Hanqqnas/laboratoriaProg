@model laboratoriaProg.Models.Movies.MovieCast

@{
ViewData["Title"] = "Dodaj postać do filmu";
}

<h2>Dodaj postać do filmu dla @ViewBag.ActorName</h2>

<form asp-controller="Actors" asp-action="AddMovie" method="post">
    <!-- Ukryte pole przekazujące ActorId -->
    <input type="hidden" name="ActorId" value="@ViewBag.ActorId" />

    <div class="mb-3">
        <label for="MovieId" class="form-label">Wybierz film:</label>
        <select name="MovieId" asp-items="ViewBag.Movies" class="form-control" required>
            <option value="">-- Wybierz film --</option>
        </select>
    </div>

    <div class="mb-3">
        <label for="CharacterName" class="form-label">Nazwa postaci:</label>
        <input type="text" name="CharacterName" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Dodaj</button>
</form>
