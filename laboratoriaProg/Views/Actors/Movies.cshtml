@model IEnumerable<dynamic>

@{
ViewData["Title"] = $"{ViewBag.ActorName} Movies";
}

<h1>Movies with @ViewBag.ActorName</h1>

<a asp-controller="Actors" asp-action="AddCharacter" asp-route-actorId="@ViewBag.ActorId" class="btn btn-primary">
    Add movie
</a>


<table class="table">
    <thead>
    <tr>
        <th>Title</th>
        <th>Budget</th>
        <th>Popularity</th>
        <th>Homepage</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
    <tr>
        <td>@movie.Title</td>
        <td>@(movie.Budget?.ToString("C") ?? "Unknown")</td>
        <td>@movie.Popularity</td>
        <td>
            @if (!string.IsNullOrEmpty(movie.Homepage))
            {
            <a href="@movie.Homepage" target="_blank">Homepage</a>
            }
            else
            {
            <span>No homepage</span>
            }
        </td>
    </tr>
    }
    </tbody>
</table>


<a asp-action="Index">Back to Actors' list</a>
